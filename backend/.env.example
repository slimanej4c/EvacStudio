# ── Développement local ─────────────────────────────────────────────────────
# Copiez ce fichier en .env. Les valeurs ci-dessous ne conviennent QUE pour le
# poste de développement : le serveur refuse de démarrer avec elles dès que
# DEBUG=False.
SECRET_KEY=django-insecure-safety-plan-creator-key-123456
JWT_SECRET=super-secret-jwt-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Production (obligatoire quand DEBUG=False) ──────────────────────────────
# SECRET_KEY            : 50+ caractères aléatoires, jamais celui du dépôt.
#                         Générer : python -c "import secrets;print(secrets.token_urlsafe(64))"
# JWT_SECRET            : OBLIGATOIRE et OBLIGATOIREMENT DIFFÉRENT de SECRET_KEY.
#                         Le démarrage est refusé s'il manque ou s'il est identique.
#                         Le changer déconnecte tout le monde.
# ALLOWED_HOSTS         : domaines servis, séparés par des virgules. Jamais '*'.
# CORS_ALLOWED_ORIGINS  : origines exactes du frontend, https:// compris.
# Le démarrage échoue explicitement si l'une des quatre manque.

# Comptes : l'inscription publique est fermée. Les comptes se créent dans
# l'admin Django. Ne passez ceci à True que temporairement et volontairement.
PUBLIC_REGISTRATION_ENABLED=False

# ── Sessions JWT ────────────────────────────────────────────────────────────
# Rotation et liste noire actives : la déconnexion révoque réellement le jeton
# de rafraîchissement côté serveur, et un jeton pivoté ne peut être rejoué.
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=7

# ── Médias ──────────────────────────────────────────────────────────────────
# /media/ n'est plus servi directement : les fichiers passent par /api/media/
# avec un cookie HttpOnly lié au compte. Voir evacuation_plans/media_access.py.
# MEDIA_SESSION_COOKIE_AGE_SECONDS=1800  session média courte (30 min)
# MEDIA_USE_X_ACCEL_REDIRECT=True  défaut en production (Nginx sert le fichier)
# MEDIA_X_ACCEL_LOCATION=/protected-media/

# ── Journaux ────────────────────────────────────────────────────────────────
# Sans LOG_DIR, tout part sur la sortie standard (capturée par systemd).
# Avec, deux fichiers tournants sont écrits : audit.log et evacstudio.log.
# LOG_DIR=/var/log/evacstudio
# LOG_LEVEL=INFO

# ── Protection de l'admin Django ────────────────────────────────────────────
# ADMIN_LOGIN_MAX_ATTEMPTS=10
# ADMIN_LOGIN_WINDOW_SECONDS=300

# ── Limites de débit (valeurs par défaut si absentes) ───────────────────────
# THROTTLE_LOGIN=10/min      devinette de mot de passe
# THROTTLE_AI=30/hour        appels payants OpenAI / xAI
# THROTTLE_UPLOAD=120/hour   écritures de fichiers
# THROTTLE_USER=2000/hour    plafond général par compte
# THROTTLE_ANON=60/hour      plafond général anonyme
# THROTTLE_MEDIA=10000/hour  médias protégés (bibliothèque chargée par lots)

# ── HTTPS derrière Nginx ────────────────────────────────────────────────────
# SECURE_SSL_REDIRECT=True   (défaut en production)
# SECURE_HSTS_SECONDS=31536000

# ── Base de données ─────────────────────────────────────────────────────────
# Absent = SQLite dans backend/db.sqlite3 (hors des répertoires servis).
# MySQL : mot de passe encodé pour une URL si nécessaire (@ devient %40, etc.).
# DATABASE_URL=mysql://evacstudio_app:mot_de_passe@127.0.0.1:3306/evacstudio
# DATABASE_URL=postgres://user:password@localhost:5432/evacuation_plans

# ── Intégrations IA ─────────────────────────────────────────────────────────
# La clé xAI de chaque utilisateur est saisie dans l'application et stockée
# chiffrée ; elle ne se met pas ici et n'est jamais renvoyée par l'API.
XAI_REQUEST_TIMEOUT_SECONDS=300
GROK_JOB_STALE_SECONDS=420
